<Window x:Class="VmTyper.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Painel de Diagnóstico — VmTyper"
        Width="860" Height="660" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Legenda fixa obrigatória dos 5 estados de entrega (§4) -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Semântica de Entrega (a cor nunca é a única pista; 'Confirmado' nunca vem apenas de SendInput):"
                           FontWeight="Bold" FontSize="11.5" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding LegendBadges}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="6,2" Margin="0,0,8,4"
                                    Background="{Binding BackgroundHex}" BorderBrush="{Binding ColorHex}" BorderThickness="1"
                                    ToolTip="{Binding Description}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FullLabel}" FontWeight="Bold" Foreground="{Binding ColorHex}" FontSize="11.5" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="#333333" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1">
            <!-- Aba 1: Sessão atual / última -->
            <TabItem Header="Sessão atual / última">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Recarregar última sessão" Click="ReloadLatestSession_Click"
                                    AutomationProperties.Name="Recarregar última sessão"/>
                            <Button Content="Abrir arquivo .jsonl..." Click="OpenSessionFile_Click"
                                    AutomationProperties.Name="Abrir arquivo JSONL de sessão"/>
                            <Button Content="Excluir diagnósticos" Click="PurgeDiagnostics_Click"
                                    AutomationProperties.Name="Excluir arquivos de diagnóstico"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SessionHeaderSummary}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="{Binding SessionTotalsSummary}" Foreground="#1E6BB8" FontWeight="Bold" Margin="0,0,0,6"/>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding TimelineEvents}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" FontFamily="Consolas" FontSize="11.5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50"/>
                            <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="95"/>
                            <DataGridTextColumn Header="Método" Binding="{Binding Method}" Width="95"/>
                            <DataGridTextColumn Header="Gap (solic. → obtido)" Binding="{Binding GapComparison}" Width="155"/>
                            <DataGridTextColumn Header="Hold (solic. → obtido)" Binding="{Binding HoldComparison}" Width="155"/>
                            <DataGridTextColumn Header="Retorno" Binding="{Binding Result}" Width="80"/>
                            <DataGridTemplateColumn Header="Estado Semântico" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="2" Padding="4,1" Background="{Binding Badge.BackgroundHex}">
                                            <TextBlock Text="{Binding Badge.FullLabel}" Foreground="{Binding Badge.ColorHex}" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Aba 2: Teste de teclado -->
            <TabItem Header="Teste de teclado">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.2*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8">
                        Use este modo para testar rapidamente se os caracteres estão sendo enviados corretamente
                        para o console VMware. Edite o texto abaixo se quiser testar caracteres específicos, clique
                        em "Enviar teste", aguarde a contagem regressiva e clique no campo de destino dentro da VM.
                    </TextBlock>

                    <TextBox Grid.Row="1" x:Name="TestTextBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="13.5" VerticalScrollBarVisibility="Auto"
                             TextChanged="TestTextBox_TextChanged"
                             AutomationProperties.Name="Texto de teste de teclado"/>

                    <TextBlock Grid.Row="2" x:Name="ExpectedFingerprintText" Margin="0,6,0,2"
                               FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Método:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="MethodCombo" Width="220" SelectedIndex="0"
                                  AutomationProperties.Name="Método do teste de teclado">
                            <ComboBoxItem Content="Automático" Tag="Automatico"/>
                            <ComboBoxItem Content="Teclado físico" Tag="TecladoFisico"/>
                            <ComboBoxItem Content="Unicode" Tag="Unicode"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                        <Button Content="Enviar teste" Click="SendTest_Click" MinWidth="120"
                                AutomationProperties.Name="Enviar teste de teclado"/>
                        <Button Content="Cancelar (ESC)" Click="Cancel_Click" MinWidth="120"
                                AutomationProperties.Name="Cancelar teste de teclado"/>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
                    </StackPanel>

                    <GroupBox Grid.Row="5" Header="Log de diagnóstico (caracteres não suportados aparecem aqui)">
                        <ListBox x:Name="LogListBox" FontFamily="Consolas" FontSize="11"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Aba 3: Comparação -->
            <TabItem Header="Comparação">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="110"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Importar JSON do receptor / página..." Click="ImportObserverJson_Click"
                                AutomationProperties.Name="Importar JSON do receptor ou página"/>
                        <TextBlock Text="Texto esperado para comparação (ou deixe o texto do teste):" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBox Grid.Row="1" Text="{Binding ComparisonExpectedText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Texto esperado para comparação"/>

                    <Border Grid.Row="2" Margin="0,8,0,8" Padding="8" CornerRadius="3"
                            Background="{Binding ComparisonDeliveryBadge.BackgroundHex}"
                            BorderBrush="{Binding ComparisonDeliveryBadge.ColorHex}" BorderThickness="1">
                        <TextBlock Text="{Binding ComparisonSummaryText}" FontWeight="Bold"
                                   Foreground="{Binding ComparisonDeliveryBadge.ColorHex}" TextWrapping="Wrap"/>
                    </Border>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding ComparisonItems}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" FontFamily="Consolas" FontSize="11.5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Classe" Binding="{Binding Kind}" Width="145"/>
                            <DataGridTextColumn Header="Pos. Esperada" Binding="{Binding ExpectedIndex}" Width="95"/>
                            <DataGridTextColumn Header="Pos. Recebida" Binding="{Binding ActualIndex}" Width="95"/>
                            <DataGridTextColumn Header="Cat. Esperada" Binding="{Binding ExpectedCategory}" Width="100"/>
                            <DataGridTextColumn Header="Cat. Recebida" Binding="{Binding ActualCategory}" Width="100"/>
                            <DataGridTextColumn Header="Contexto (±5)" Binding="{Binding ContextWindow}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Aba 4: Desempenho por método/perfil -->
            <TabItem Header="Desempenho por método/perfil">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Recarregar benchmarks" Click="ReloadBenchmarks_Click"
                                AutomationProperties.Name="Recarregar tabela de benchmarks"/>
                        <TextBlock Text="Benchmarks executados (lidos de relatorios/F3-dados):" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding BenchmarkRows}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" FontFamily="Consolas" FontSize="11.5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Origem" Binding="{Binding Source}" Width="95"/>
                            <DataGridTextColumn Header="Corpus" Binding="{Binding Corpus}" Width="165"/>
                            <DataGridTextColumn Header="Método" Binding="{Binding Method}" Width="175"/>
                            <DataGridTextColumn Header="Perfil" Binding="{Binding Profile}" Width="115"/>
                            <DataGridTextColumn Header="Esperado" Binding="{Binding ExpectedLength}" Width="70"/>
                            <DataGridTextColumn Header="Recebido" Binding="{Binding ActualLength}" Width="70"/>
                            <DataGridTextColumn Header="SHA-256(12)" Binding="{Binding Sha12}" Width="105"/>
                            <DataGridTextColumn Header="Div." Binding="{Binding Divergences}" Width="50"/>
                            <DataGridTemplateColumn Header="Estado" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="2" Padding="4,1" Background="{Binding Badge.BackgroundHex}">
                                            <TextBlock Text="{Binding Badge.FullLabel}" Foreground="{Binding Badge.ColorHex}" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
