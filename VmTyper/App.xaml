<Application x:Class="VmTyper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AccentBrush" Color="#2D7DD2"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#D23838"/>
            <SolidColorBrush x:Key="WarnBrush" Color="#D2A038"/>
            <SolidColorBrush x:Key="OkBrush" Color="#2FA84F"/>

            <Style TargetType="Button">
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="MinWidth" Value="90"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
            </Style>

            <Style TargetType="GroupBox">
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="Padding" Value="6"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
