<Application x:Class="VmTyper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- A ordem importa: [0] tema (substituído em tempo de execução pelo ThemeManager), depois tokens, design system e controles. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VmTyper;component/Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/VmTyper;component/Themes/Tokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/VmTyper;component/Themes/DesignSystem.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/VmTyper;component/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
